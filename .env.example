# Stockyard environment template.
# Скопируй в .env и заполни значения. .env коммитить в git ЗАПРЕЩЕНО (см. .gitignore).
# См. docs/architecture/12-storage-operations.md §12.4.
#
# Генерация секретов одной командой:
#   openssl rand -base64 32

# --- PostgreSQL ----------------------------------------------------------
PG_USER=stockyard
PG_PASSWORD=
PG_DB=stockyard

# Read-only роль для postgres_exporter, создаётся V7 миграцией.
MONITORING_PASSWORD=

# --- Redis ---------------------------------------------------------------
REDIS_PASSWORD=

# --- ClickHouse ----------------------------------------------------------
CH_USER=stockyard
CH_PASSWORD=

# --- Application secrets -------------------------------------------------
# JWT_SECRET — HS256 ключ для подписи access/refresh-токенов в gateway-service.
# Минимум 32 байта. Сгенерировать: openssl rand -base64 32
JWT_SECRET=
# Pepper для argon2id паролей (используется в core-service, не gateway).
ARGON2_PEPPER=

# --- Gateway service -----------------------------------------------------
GATEWAY_PORT=8080

# --- Observability -------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=core-service          # переопределяется per-service в compose
DEPLOYMENT_ENVIRONMENT=dev              # dev | demo
